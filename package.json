{
  "name": "agentic-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/runtime-panel",
    "packages/extension",
    "packages/mcp-server",
    "packages/cli",
    "packages/runtime-extension",
    "packages/keyvault-extension",
    "packages/safari-extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w packages/shared",
    "build:runtime-panel": "npm run build -w packages/runtime-panel",
    "build:extension": "npm run build -w packages/extension",
    "build:server": "npm run build -w packages/mcp-server",
    "build:runtime-extension": "npm run build -w packages/runtime-extension",
    "build:keyvault": "npm run build -w packages/keyvault-extension",
    "build:safari-extension": "npm run build -w packages/safari-extension",
    "package:safari": "node scripts/package-safari.mjs",
    "dev": "npm run dev -w packages/extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --force",
    "build:cli": "npm run build -w packages/cli",
    "cli": "node packages/cli/dist/index.js",
    "clean": "rimraf --glob \"packages/*/dist\" \"packages/*/*.tsbuildinfo\" packages/extension/build",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/node": "22.13.4",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.20.1",
    "eslint-config-prettier": "10.0.1",
    "lint-staged": "15.4.3",
    "prettier": "3.5.2",
    "rimraf": "6.0.1",
    "simple-git-hooks": "2.11.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.1",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
