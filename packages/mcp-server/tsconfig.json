{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["../shared/src/*"]
    }
