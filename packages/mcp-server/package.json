{
  "name": "@agentic-browser/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser-tools": {
      "types": "./dist/browser-tools-api.d.ts",
      "import": "./dist/browser-tools-api.js"
    },
    "./runtime-api": {
      "types": "./dist/runtime-api.d.ts",
      "import": "./dist/runtime-api.js"
    }
  },
  "bin": {
    "agentic-browser-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --watch --project tsconfig.json",
    "start": "node dist/index.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@agentic-browser/shared": "*",
    "@modelcontextprotocol/sdk": "^1.5.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
