{
  "manifest_version": 2,
  "name": "Agentic Browser for Safari",
  "version": "0.1.0",
  "description": "Instance-bound Safari integration for Marshal browser automation.",
  "permissions": ["activeTab", "tabs", "storage", "nativeMessaging"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "extension_id": "com.marshal.agentic-browser.safari"
    }
  }
}
