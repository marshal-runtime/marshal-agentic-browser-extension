{
  "manifest_version": 3,
  "name": "Marley",
  "version": "0.5.0",
  "description": "Lets Marley work in your own Chrome, inside a purple 'Marley' tab group, when it needs your sign-ins.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Marley",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "webNavigation",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://app.marleyagent.com/*",
    "https://app-staging.marley.zygedge.com/*",
    "http://localhost:3107/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://app.marleyagent.com/*",
      "https://app-staging.marley.zygedge.com/*",
      "http://localhost:3107/*"
    ]
  }
}
